    family-names: Brauner
    email: brauner@comm.rwth-aachen.de
    affiliation: Chair of Communication Science, RWTH Aachen University
repository-code: "https://github.com/askurious/askurious"
license: EUPL-1.2
keywords:
  - survey
  - questionnaire
  - research software
  - conjoint analysis
  - experience sampling
